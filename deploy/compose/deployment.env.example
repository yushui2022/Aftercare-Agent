# Copy outside the repository and inject real values from the target secret
# manager. Prefer an immutable digest, not a moving tag.
AFTERCARE_IMAGE=registry.example/aftercare-agent@sha256:replace-me
AFTERCARE_RUNTIME_DATABASE_ROLE=aftercare_runtime

# Host paths to one-line secret files. Use different PostgreSQL login roles;
# the runtime role must not own the database or have CREATE on the schema.
# Both DSNs must include sslmode=verify-full and use a trusted CA chain.
# Copy this env file outside the repository and replace both paths.
AFTERCARE_MIGRATION_DATABASE_URL_FILE=/secure/aftercare/migration-database-url
AFTERCARE_RUNTIME_DATABASE_URL_FILE=/secure/aftercare/runtime-database-url
AFTERCARE_REQUIRE_DATABASE_TLS=1

AFTERCARE_OIDC_ISSUER=https://idp.example/
AFTERCARE_OIDC_AUDIENCE=aftercare-api
AFTERCARE_OIDC_JWKS_URL=https://idp.example/.well-known/jwks.json

# Model strategy identity is recorded in each Run checkpoint. Keep this stable
# during a rollout; changing it parks existing Runs in REVIEW until an explicit
# strategy migration exists.
AFTERCARE_MODEL_STRATEGY_ID=aftercare-investigation
AFTERCARE_MODEL_CONFIG_VERSION=provider-model-config-v1
AFTERCARE_MODEL_POLICY_VERSION=policy-v1
AFTERCARE_MODEL_TOOL_SCHEMA_VERSION=tools-v1

# Bind behind a TLS ingress/reverse proxy unless the selected platform supplies
# service networking. These are starting values to measure, not capacity claims.
AFTERCARE_BIND_ADDRESS=127.0.0.1
AFTERCARE_API_PORT=8000
AFTERCARE_API_POOL_MIN_SIZE=1
AFTERCARE_API_POOL_MAX_SIZE=8
AFTERCARE_WORKER_POOL_MIN_SIZE=1
AFTERCARE_WORKER_POOL_MAX_SIZE=4
AFTERCARE_DB_ACQUIRE_TIMEOUT_SECONDS=5
AFTERCARE_POOL_METRICS=1
AFTERCARE_POOL_METRICS_INTERVAL_SECONDS=10
AFTERCARE_QUEUE_METRICS=1
AFTERCARE_QUEUE_METRICS_INTERVAL_SECONDS=10
AFTERCARE_METRICS_BACKEND=logging

# RLS currently runs tenant-pinned Workers. Set this to the tenant handled by
# this Worker replica; deploy one Worker replica per tenant until a separately
# audited cross-tenant dispatcher exists.
AFTERCARE_TENANT_ID=replace-with-tenant-id

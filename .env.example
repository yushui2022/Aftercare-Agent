# Aftercare local profile only. Copy to .env for Compose or shell experiments.
# Never put production credentials, real customer data, or live provider keys here.

# Local PostgreSQL exposed by deploy/compose/docker-compose.yml
DATABASE_URL=postgresql://aftercare:local-only-aftercare@localhost:55433/aftercare
# Deployment processes may use DATABASE_URL_FILE instead. Never configure both.
# DATABASE_URL_FILE=/run/secrets/aftercare_database_url
AFTERCARE_POSTGRES_PORT=55433
AFTERCARE_API_PORT=8000
AFTERCARE_AUTO_MIGRATE=1

# Synthetic identity is for local development only and must be disabled in a
# deployment profile with a real OIDC/JWKS verifier.
AFTERCARE_ALLOW_SYNTHETIC_IDENTITY=1

# Optional bounded Worker slice. Leave the IDs empty to let the durable queue
# select a runnable Run.
AFTERCARE_TENANT_ID=tenant-demo
AFTERCARE_RUN_ID=
AFTERCARE_WORKER_ID=worker-local
AFTERCARE_WORKER_DAEMON=0
AFTERCARE_MAX_STEPS=8
AFTERCARE_LEASE_SECONDS=30
AFTERCARE_IDLE_SLEEP_SECONDS=1

# Bounded per-process PostgreSQL pool defaults for local use.
AFTERCARE_DB_POOL_MIN_SIZE=1
AFTERCARE_DB_POOL_MAX_SIZE=8
AFTERCARE_DB_ACQUIRE_TIMEOUT_SECONDS=5
AFTERCARE_POOL_METRICS=1
AFTERCARE_POOL_METRICS_INTERVAL_SECONDS=10
AFTERCARE_QUEUE_METRICS=1
AFTERCARE_QUEUE_METRICS_INTERVAL_SECONDS=10
# logging is the dependency-free default; otel requires an image with an
# OpenTelemetry SDK/exporter/provider configured by the deployment.
AFTERCARE_METRICS_BACKEND=logging

# Optional model harness. Empty means no real model credential is configured.
AFTERCARE_HARNESS_MODEL=
AFTERCARE_MODEL_API_KEY=
# AFTERCARE_MODEL_API_KEY_FILE=/run/secrets/aftercare_model_api_key
AFTERCARE_MODEL_BASE_URL=
AFTERCARE_MODEL_STRATEGY_ID=aftercare-investigation
# The config version is pinned into each model Run checkpoint. Change it only
# with an explicit rollout plan; a resumed Run with a different version fails closed.
AFTERCARE_MODEL_CONFIG_VERSION=
AFTERCARE_MODEL_POLICY_VERSION=policy-v1
AFTERCARE_MODEL_TOOL_SCHEMA_VERSION=tools-v1
AFTERCARE_MODEL_CALLS=0
AFTERCARE_MODEL_INPUT_MICROUSD_PER_TOKEN=0
AFTERCARE_MODEL_OUTPUT_MICROUSD_PER_TOKEN=0

# Required when AFTERCARE_HARNESS_MODEL is enabled. These are deployment
# policy choices, so the application has no production freshness defaults.
AFTERCARE_INVESTIGATION_POLICY_ID=local-investigation-policy
AFTERCARE_INVESTIGATION_POLICY_VERSION=1
AFTERCARE_ORDER_MAX_AGE_SECONDS=86400
AFTERCARE_CARRIER_MAX_AGE_SECONDS=21600
AFTERCARE_BUYER_MAX_AGE_SECONDS=604800

# Development commerce dataset and source identifiers.
AFTERCARE_COMMERCE_DATASET=default
AFTERCARE_SOURCE_ORDER_LEDGER=order-ledger-local
AFTERCARE_SOURCE_CARRIER=carrier-local
AFTERCARE_SOURCE_BUYER_CHANNEL=buyer-channel-local
